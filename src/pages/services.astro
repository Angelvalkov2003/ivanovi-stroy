---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ServiceGallery from '~/components/ServiceGallery.astro';
import GallerySearch from '~/components/GallerySearch.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { serviceCategories } from '~/data/services';
import { getPermalink } from '~/utils/permalinks';
import { entranceIntersect } from '~/utils/entrance';
import { SITE_BRAND, SITE_CONTACT } from '~/data/site';

const metadata = {
  title: 'Строителни услуги София',
  description:
    'Кофраж, бетон, гипсокартон, ВиК, ЕЛ, баня, плочки, къртене и извозване в София. Иванови Строй — всички ремонтни дейности.',
};
---

<Layout metadata={metadata}>
  <HeroText tagline="Услуги" title="Строителни услуги в София" />

  <section class:list={[entranceIntersect(), 'pb-8 -mt-8']}>
    <div class="max-w-3xl mx-auto px-4 text-center text-[#8f8f8f]">
      <p>
        {SITE_BRAND.name} предлага пълен спектър строителни и ремонтни дейности — от груб строеж до баня до ключ.
        Изберете услуга и натиснете „Виж услуга“ за подробности, снимки и оферта.
      </p>
    </div>
  </section>

  <Features2
    id="napravlenia"
    columns={3}
    title="Нашите направления"
    subtitle="Пълен списък услуги — снимки по-долу"
    items={serviceCategories.map((cat) => ({
      title: cat.title,
      description: cat.summary,
      icon: cat.icon,
      searchText: [cat.title, cat.summary, cat.id].join(' ').toLowerCase(),
      callToAction: {
        text: 'Виж услуга',
        href: getPermalink(`/uslugi/${cat.slug}`),
      },
    }))}
  >
    <GallerySearch slot="afterSubtitle" totalCount={serviceCategories.length} />
  </Features2>

  <ServiceGallery />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: SITE_CONTACT.phone,
        href: `tel:${SITE_CONTACT.phoneTel}`,
        icon: 'tabler:phone',
      },
    ]}
    title="Безплатен оглед и оферта"
    subtitle="Обадете се днес — работим в София и областта, без почивен ден."
  />
</Layout>
