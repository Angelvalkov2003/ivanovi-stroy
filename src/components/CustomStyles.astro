---
import '@fontsource-variable/inter';
---

<style is:inline>
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: rgb(199 147 5);
    --aw-color-secondary: rgb(143 143 143);
    --aw-color-accent: rgb(199 147 5);

    --aw-color-text-heading: rgb(20 20 20);
    --aw-color-text-default: rgb(20 20 20);
    --aw-color-text-muted: rgb(143 143 143);
    --aw-color-bg-page: 255 255 255;

    --brand-gold: #c79305;
    --brand-gray: #8f8f8f;
    --brand-dark: #141414;
    --brand-nav: #121212;

    ::selection {
      background-color: #c79305;
      color: #fff;
    }
  }
</style>
