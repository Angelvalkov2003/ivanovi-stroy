---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import ServiceGallery from '~/components/ServiceGallery.astro';
import ContactButtons from '~/components/ContactButtons.astro';
import { SITE_BRAND, SITE_CONTACT } from '~/data/site';
import { mainServices, whyChooseUs } from '~/data/services';
import { entranceIntersect, entranceLoad } from '~/utils/entrance';

const metadata = {
  title: 'Строителна фирма София — Кърти, Чисти, Извозва',
  description: SITE_BRAND.description,
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    animated
    actions={[
      {
        variant: 'primary',
        text: 'Обади се сега',
        href: `tel:${SITE_CONTACT.phoneTel}`,
        icon: 'tabler:phone',
      },
      { text: 'Виж услугите', href: '/services' },
    ]}
    image={{ src: '/mainpic1.png', alt: SITE_BRAND.name }}
  >
    <Fragment slot="title">
      <span
        class:list={[
          entranceLoad(0),
          'block text-[#c79305] text-sm sm:text-2xl md:text-3xl font-bold tracking-tight whitespace-nowrap',
        ]}
      >
        {SITE_BRAND.tagline}
      </span>
      <span class:list={[entranceLoad(1), 'block text-[#141414] text-4xl sm:text-5xl md:text-6xl mt-1']}>
        {SITE_BRAND.name}
      </span>
    </Fragment>
    <Fragment slot="subtitle">
      Строителна фирма в <strong>София и областта</strong> — къртене, почистване, извозване, кофраж, бетон, ВиК, ЕЛ и
      ремонти до ключ. <span class="text-[#c79305] font-semibold">Безплатен оглед и оферта!</span>
    </Fragment>
  </Hero>

  <section class:list={[entranceIntersect(), 'bg-gradient-to-b from-[#c79305]/10 to-white py-6']}>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 flex flex-col items-center gap-3">
      <ContactButtons />
      <p class="text-center text-[#8f8f8f] text-sm font-medium">Работа без почивен ден</p>
    </div>
  </section>

  <Features
    id="uslugi"
    tagline="Услуги"
    title="Всичко за строителството"
    subtitle="От къртене и извозване до довършителни ремонти — професионално и на конкурентни цени."
    columns={2}
    items={mainServices.map((text) => ({
      title: text,
      description: '',
      icon: 'tabler:check',
    }))}
  />

  <Content
    isReversed
    tagline="Защо ние"
    title="Защо да изберете нас?"
    items={whyChooseUs.map((text) => ({
      title: text,
      description: '',
      icon: 'tabler:circle-check-filled',
    }))}
    image={{
      src: '/mainpic2.png',
      alt: 'Строителна фирма София',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold text-[#141414] mb-2">Омега депониране на отпадъци</h3>
      <p class="text-[#8f8f8f]">
        Гарантираме екологично изхвърляне на отпадъците според всички изисквания — извозване до лицензирани депа.
      </p>
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-[#f5f5f5]"></div>
    </Fragment>
  </Content>

  <ServiceGallery />

  <section class:list={[entranceIntersect(), 'py-16 md:py-20 bg-[#121212] text-white']}>
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h2 class:list={[entranceIntersect(), 'text-3xl md:text-4xl font-bold mb-3']} style="--i: 0">
        Готови сте за вашия проект?
      </h2>
      <p class:list={[entranceIntersect(), 'text-[#8f8f8f] mb-8']} style="--i: 1">
        Обадете се на <strong class="text-white">{SITE_CONTACT.phoneIntl}</strong> — отговаряме бързо, работим в София
        и областта.
      </p>
      <div class:list={[entranceIntersect(), 'flex justify-center']} style="--i: 2">
        <ContactButtons />
      </div>
    </div>
  </section>
</Layout>
