---
import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';

import type { Hero as Props } from '~/types';
import { entranceIntersect, entranceLoad } from '~/utils/entrance';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,

  content = await Astro.slots.render('content'),
  actions = await Astro.slots.render('actions'),
  image = await Astro.slots.render('image'),

  animated = false,
  id,
  bg = await Astro.slots.render('bg'),
} = Astro.props;

const intersectFade = entranceIntersect();
---

<section
  class:list={['relative md:-mt-[76px] not-prose', animated && 'entrance-load']}
  {...id ? { id } : {}}
>
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <slot name="bg">
      {bg ? <Fragment set:html={bg} /> : null}
    </slot>
  </div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
    <div class="pt-0 md:pt-[76px] pointer-events-none"></div>
    <div class="py-12 md:py-20">
      <div class="text-center pb-10 md:pb-16 max-w-5xl mx-auto">
        {
          tagline && (
            <p
              class:list={[
                animated ? entranceLoad(0) : entranceIntersect(),
                'text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase',
              ]}
              set:html={tagline}
            />
          )
        }
        {
          title && (
            <h1
              class:list={[
                'font-bold leading-tighter tracking-tighter mb-4 font-heading dark:text-gray-200',
                !animated && 'text-5xl md:text-6xl',
                !animated && intersectFade,
              ]}
              set:html={title}
            />
          )
        }
        <div class="max-w-3xl mx-auto">
          {
            subtitle && (
              <p
                class:list={[
                  'text-xl text-muted mb-6 dark:text-slate-300',
                  animated ? entranceLoad(2) : intersectFade,
                ]}
                set:html={subtitle}
              />
            )
          }
          {
            actions && (
              <div
                class:list={[
                  'max-w-xs sm:max-w-md m-auto flex flex-nowrap flex-col sm:flex-row sm:justify-center gap-4',
                  animated ? entranceLoad(3) : intersectFade,
                ]}
              >
                {Array.isArray(actions) ? (
                  actions.map((action) => (
                    <div class="flex w-full sm:w-auto">
                      <Button {...(action || {})} class="w-full sm:mb-0" />
                    </div>
                  ))
                ) : (
                  <Fragment set:html={actions} />
                )}
              </div>
            )
          }
        </div>
        {content && <Fragment set:html={content} />}
      </div>
      <div
        class:list={[
          animated ? entranceLoad(4) : entranceIntersect('intersect-no-queue'),
        ]}
      >
        {
          image && (
            <div class="relative m-auto max-w-5xl">
              {typeof image === 'string' ? (
                <Fragment set:html={image} />
              ) : (
                <Image
                  class="mx-auto rounded-md w-full"
                  widths={[400, 768, 1024, 2040]}
                  sizes="(max-width: 767px) 400px, (max-width: 1023px) 768px, (max-width: 2039px) 1024px, 2040px"
                  loading="eager"
                  fetchpriority="high"
                  width={1024}
                  height={576}
                  format="webp"
                  {...image}
                />
              )}
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>
