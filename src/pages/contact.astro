---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import ContactButtons from '~/components/ContactButtons.astro';
import { SITE_BRAND, SITE_CONTACT } from '~/data/site';
import { entranceIntersect } from '~/utils/entrance';

const metadata = {
  title: 'Контакти',
  description: `Свържете се с ${SITE_BRAND.name} — телефон ${SITE_CONTACT.phone}, София и областта. WhatsApp и Viber.`,
};
---

<Layout metadata={metadata}>
  <HeroText tagline="Контакти" title="Обадете се сега!" />

  <Features2
    title="Свържете се с нас"
    subtitle="Безплатен оглед и оферта · Бърз отговор"
    columns={2}
    items={[
      {
        title: 'Телефон',
        description: `<span class="text-[#c79305] font-bold text-xl">${SITE_CONTACT.phone}</span>`,
        icon: 'tabler:phone',
        href: `tel:${SITE_CONTACT.phoneTel}`,
      },
      {
        title: 'WhatsApp',
        description: '<span class="text-[#c79305]">Пишете в WhatsApp</span>',
        icon: 'tabler:brand-whatsapp',
        href: SITE_CONTACT.whatsapp,
        linkTarget: '_blank',
        linkRel: 'noopener noreferrer',
      },
      {
        title: 'Viber',
        description: '<span class="text-[#c79305]">Пишете в Viber</span>',
        icon: 'tabler:message-circle',
        href: SITE_CONTACT.viber,
      },
      {
        title: 'Имейл',
        description: `<span class="text-[#c79305]">${SITE_CONTACT.email}</span>`,
        icon: 'tabler:mail',
        href: `mailto:${SITE_CONTACT.email}`,
      },
      {
        title: 'Локация',
        description: SITE_CONTACT.location,
        icon: 'tabler:map-pin',
        href: `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(SITE_CONTACT.location)}`,
        linkTarget: '_blank',
        linkRel: 'noopener noreferrer',
      },
      {
        title: 'Работно време',
        description: 'Работа без почивен ден — удобно за спешни поръчки',
        icon: 'tabler:clock',
      },
    ]}
  />

  <section class:list={[entranceIntersect(), 'py-12 bg-[#f8f8f8]']}>
    <div class="max-w-xl mx-auto px-4 text-center">
      <h2 class:list={[entranceIntersect(), 'text-2xl font-bold text-[#141414] mb-4']} style="--i: 0">
        Обадете се сега!
      </h2>
      <p class:list={[entranceIntersect(), 'text-[#8f8f8f] mb-6']} style="--i: 1">
        Безплатен оглед и оферта за вашия обект в София и областта.
      </p>
      <div class:list={[entranceIntersect(), 'flex justify-center']} style="--i: 2">
        <ContactButtons size="md" />
      </div>
    </div>
  </section>
</Layout>
