---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import ToggleMenu from '~/components/common/ToggleMenu.astro';
import Button from '~/components/ui/Button.astro';

import { getHomePermalink } from '~/utils/permalinks';
import { trimSlash, getAsset } from '~/utils/permalinks';
import { isNavLinkActive, navLinkActiveClass } from '~/utils/nav-active';
import type { CallToAction } from '~/types';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface MenuLink extends Link {
  links?: Array<MenuLink>;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  actions?: Array<CallToAction>;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  showToggleTheme?: boolean;
  showRssFeed?: boolean;
  position?: string;
}

const {
  id = 'header',
  links = [],
  actions = [],
  isSticky = false,
  isDark = false,
  isFullWidth = false,
  showToggleTheme = false,
  showRssFeed = false,
  position = 'center',
} = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;

const gridCols =
  position === 'center'
    ? 'md:grid-cols-3'
    : 'md:grid-cols-[minmax(0,auto)_minmax(0,1fr)_minmax(0,auto)]';
---

<header
  class:list={[
    { sticky: isSticky, relative: !isSticky, dark: isDark },
    'top-0 z-40 flex-none mx-auto w-full border-b border-gray-50/0 transition-[opacity] ease-in-out',
  ]}
  {...isSticky ? { 'data-aw-sticky-header': true } : {}}
  {...id ? { id } : {}}
>
  <div
    class:list={[
      'header-inner relative text-default py-3 max-md:py-4 px-4 sm:px-6 mx-auto w-full min-w-0',
      'md:grid md:items-center md:gap-x-4 lg:gap-x-6',
      gridCols,
      { 'max-w-7xl': !isFullWidth },
    ]}
  >
    <div class="flex items-center justify-between gap-3 min-w-0 md:justify-self-start">
      <a class="flex items-center shrink-0 max-w-[min(100%,18rem)] md:max-w-[13rem]" href={getHomePermalink()}>
        <Logo />
      </a>
      <div class="flex items-center md:hidden shrink-0 gap-2">
        {
          actions?.length ? (
            actions.map((btnProps) => (
              <Button
                {...btnProps}
                class="py-2 px-3 font-semibold shadow-none text-xs whitespace-nowrap"
              />
            ))
          ) : null
        }
        <ToggleMenu class="flex flex-col h-11 w-11 rounded-lg justify-center items-center cursor-pointer text-white group" />
      </div>
    </div>

    <nav
      class="items-center w-full hidden md:flex min-w-0 text-default md:overflow-visible md:justify-self-center"
      aria-label="Main navigation"
    >
      <ul
        class="flex flex-col md:flex-row md:flex-wrap md:justify-center w-full md:w-auto gap-0 md:gap-0.5 text-xl md:text-[0.9375rem] tracking-[0.01rem] font-medium"
      >
        {
          links.map(({ text, href, links: subLinks }) => (
            <li class={subLinks?.length ? 'dropdown' : ''}>
              {subLinks?.length ? (
                <>
                  <button
                    type="button"
                    class="hover:text-link dark:hover:text-white px-3 lg:px-4 py-3 flex items-center whitespace-nowrap"
                  >
                    {text}{' '}
                    <Icon name="tabler:chevron-down" class="w-3.5 h-3.5 ml-0.5 rtl:ml-0 rtl:mr-0.5 hidden md:inline" />
                  </button>
                  <ul class="dropdown-menu md:backdrop-blur-md dark:md:bg-dark rounded md:absolute pl-4 md:pl-0 md:hidden font-medium md:bg-white/90 md:min-w-[200px] drop-shadow-xl">
                    {subLinks.map(({ text: text2, href: href2 }) => (
                      <li>
                        <a
                          class:list={[
                            'first:rounded-t last:rounded-b md:hover:bg-gray-100 hover:text-link dark:hover:text-white dark:hover:bg-gray-700 py-2 px-5 block whitespace-no-wrap',
                            isNavLinkActive(href2, currentPath) && navLinkActiveClass,
                          ]}
                          href={href2}
                        >
                          {text2}
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <a
                  class:list={[
                    'hover:text-[#c79305] px-3 lg:px-4 py-3 flex items-center whitespace-nowrap transition-colors',
                    isNavLinkActive(href, currentPath, text) ? navLinkActiveClass : 'text-white',
                  ]}
                  href={href}
                  aria-current={isNavLinkActive(href, currentPath, text) ? 'page' : undefined}
                >
                  {text}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div
      data-aw-header-actions
      class="hidden md:flex items-center shrink-0 md:justify-self-end"
    >
      <div class="items-center flex justify-end w-full md:w-auto gap-2">
        <div class="flex">
          {showToggleTheme && <ToggleTheme iconClass="w-6 h-6 md:w-5 md:h-5 md:inline-block" />}
          {
            showRssFeed && (
              <a
                class="text-muted dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5 inline-flex items-center"
                aria-label="RSS Feed"
                href={getAsset('/rss.xml')}
              >
                <Icon name="tabler:rss" class="w-5 h-5" />
              </a>
            )
          }
        </div>
        {
          actions?.length ? (
            <span class="shrink-0">
              {actions.map((btnProps) => (
                <Button
                  {...btnProps}
                  class="py-2.5 px-4 lg:px-6 font-semibold shadow-none text-sm whitespace-nowrap"
                />
              ))}
            </span>
          ) : (
            ''
          )
        }
      </div>
    </div>
  </div>

  <div
    id="mobile-menu-backdrop"
    class="mobile-menu-backdrop md:hidden"
    aria-hidden="true"
    data-mobile-menu-backdrop
  />

  <aside
    id="mobile-menu-panel"
    class="mobile-menu-panel md:hidden"
    aria-hidden="true"
    aria-label="Мобилно меню"
  >
    <div class="flex items-center justify-between gap-4 px-8 pt-8 pb-6 border-b border-white/10">
      <a class="flex items-center shrink-0 max-w-[11rem]" href={getHomePermalink()}>
        <Logo />
      </a>
      <button
        type="button"
        class="mobile-menu-close shrink-0 p-2.5 rounded-full text-white/90 hover:bg-white/10 hover:text-[#c79305] transition-colors"
        aria-label="Затвори меню"
        data-mobile-menu-close
      >
        <Icon name="tabler:x" class="w-7 h-7" />
      </button>
    </div>

    <nav class="flex-1 overflow-y-auto px-8 py-8" aria-label="Мобилна навигация">
      <ul class="flex flex-col">
        {
          links.map(({ text, href, links: subLinks }) => (
            <li class="border-b border-white/5 last:border-0">
              {subLinks?.length ? (
                <>
                  <span class="block px-2 py-5 text-lg font-semibold text-white/90">{text}</span>
                  <ul class="pb-4 pl-4">
                    {subLinks.map(({ text: text2, href: href2 }) => (
                      <li>
                        <a
                          class:list={[
                            'block py-3 px-2 text-base text-white/80 hover:text-[#c79305] transition-colors',
                            isNavLinkActive(href2, currentPath) && navLinkActiveClass,
                          ]}
                          href={href2}
                        >
                          {text2}
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <a
                  class:list={[
                    'block py-5 px-2 text-lg font-medium hover:text-[#c79305] transition-colors',
                    isNavLinkActive(href, currentPath, text) ? navLinkActiveClass : 'text-white',
                  ]}
                  href={href}
                  aria-current={isNavLinkActive(href, currentPath, text) ? 'page' : undefined}
                >
                  {text}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    {
      actions?.length ? (
        <div class="shrink-0 px-8 py-8 border-t border-white/10" data-aw-header-actions-mobile>
          {actions.map((btnProps) => (
            <Button
              {...btnProps}
              class="w-full py-3.5 px-6 font-semibold shadow-none text-base justify-center"
            />
          ))}
        </div>
      ) : null
    }
  </aside>
</header>
