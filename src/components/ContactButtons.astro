---
import { Icon } from 'astro-icon/components';
import { SITE_CONTACT } from '~/data/site';

interface Props {
  showPhone?: boolean;
  showLabels?: boolean;
  size?: 'sm' | 'md';
}

const { showPhone = true, showLabels = true, size = 'md' } = Astro.props;

const sizeClasses = size === 'sm' ? 'px-3 py-2 text-xs gap-1.5' : 'px-5 py-2.5 text-sm gap-2';
const iconSize = size === 'sm' ? 'w-4 h-4' : 'w-5 h-5';
const btnBase = `inline-flex items-center justify-center font-semibold rounded-full transition shadow-sm hover:scale-[1.02] active:scale-[0.98] ${sizeClasses}`;
---

<div class="flex flex-wrap items-center justify-center gap-3">
  {
    showPhone && (
      <a
        href={`tel:${SITE_CONTACT.phoneTel}`}
        class:list={[btnBase, 'bg-[#c79305] text-white hover:bg-[#a67d04]']}
        aria-label={`Обади се на ${SITE_CONTACT.phoneIntl}`}
      >
        <Icon name="tabler:phone" class={iconSize} />
        {showLabels && <span>{SITE_CONTACT.phoneIntl}</span>}
      </a>
    )
  }
  <a
    href={SITE_CONTACT.whatsapp}
    target="_blank"
    rel="noopener noreferrer"
    class:list={[btnBase, 'bg-[#25D366] text-white hover:bg-[#1da851]']}
    aria-label="WhatsApp"
  >
    <Icon name="tabler:brand-whatsapp" class={iconSize} />
    {showLabels && <span>WhatsApp</span>}
  </a>
  <a
    href={SITE_CONTACT.viber}
    class:list={[btnBase, 'bg-[#7360f2] text-white hover:bg-[#5b4dd9]']}
    aria-label="Viber"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class={iconSize} aria-hidden="true">
      <path
        d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.8 9.8 0 0 0 12.04 2m5.4 13.87c-.29.81-1.48 1.56-2.04 1.66-.52.1-1.19.14-1.92-.12-.44-.15-.99-.33-1.7-.65-2.99-1.3-4.95-4.35-5.1-4.56-.15-.21-1.22-1.62-1.22-3.09 0-1.47.77-2.19 1.04-2.49.27-.3.59-.37.79-.37.2 0 .39 0 .56.01.18 0 .42-.07.66.5.25.58.84 2.05.92 2.2.08.15.13.33.02.53-.1.2-.15.33-.3.51-.15.18-.31.4-.44.54-.15.15-.3.31-.13.61.17.29.75 1.24 1.62 2.01 1.11.99 2.05 1.3 2.34 1.45.29.15.46.13.63-.08.17-.2.72-.84.91-1.13.19-.29.38-.24.63-.14.26.1 1.62.76 1.9.9.28.14.46.21.53.33.07.12.07.7-.22 1.51z"
      ></path>
    </svg>
    {showLabels && <span>Viber</span>}
  </a>
</div>
