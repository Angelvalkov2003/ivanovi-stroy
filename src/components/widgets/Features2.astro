---
import { Icon } from 'astro-icon/components';
import Button from '~/components/ui/Button.astro';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { Features as Props } from '~/types';
import { entranceIntersect } from '~/utils/entrance';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline = await Astro.slots.render('tagline'),
  items = [],
  columns = 3,
  defaultIcon,

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;

const hasAfterSubtitle = Astro.slots.has('afterSubtitle');
const hasSearchableItems = items.some((item) => item.searchText);

const columnsClass =
  columns === 4
    ? 'lg:grid-cols-4 md:grid-cols-3 sm:grid-cols-2'
    : columns === 3
      ? 'lg:grid-cols-3 sm:grid-cols-2'
      : columns === 2
        ? 'sm:grid-cols-2'
        : '';
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-7xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <Headline
    title={title}
    subtitle={subtitle}
    tagline={tagline}
    classes={{
      ...(classes?.headline as Record<string, string>),
      container: hasAfterSubtitle
        ? 'max-w-3xl mb-4 md:mb-5'
        : ((classes?.headline as Record<string, string>)?.container ?? undefined),
    }}
  />

  {
    hasAfterSubtitle && (
      <div class="mt-2 mb-8 md:mb-10 w-full max-w-3xl mx-auto">
        <slot name="afterSubtitle" />
      </div>
    )
  }

  {
    items.length > 0 && (
      <>
        <p
          id="service-search-empty"
          class:list={['hidden text-center text-[#8f8f8f] py-6', !hasSearchableItems && '!hidden']}
        >
          Няма намерени направления. Опитайте с друга дума.
        </p>
        <div
          id={hasSearchableItems ? 'service-directions-grid' : undefined}
          class:list={['grid gap-4 md:gap-6 gap-x-12', columnsClass]}
        >
        {items.map(
          ({ title: itemTitle, description, icon, callToAction, href, linkTarget, linkRel, searchText }, index) => {
            const cardClasses = [
              entranceIntersect(),
              searchText && 'service-direction-card',
              'intersect-no-queue relative flex flex-col rounded-lg shadow-[0_4px_30px_rgba(0,0,0,0.1)] dark:shadow-[0_4px_30px_rgba(0,0,0,0.1)] backdrop-blur border border-[#ffffff29] bg-white dark:bg-slate-900 p-6',
              href &&
                'no-underline text-inherit cursor-pointer transition hover:border-[#c79305]/40 hover:shadow-[0_8px_40px_rgba(199,147,5,0.15)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#c79305]',
            ];
            const cardStyle = `--i: ${index}`;

            const cardContent = (
              <>
                {(icon || defaultIcon) && <Icon name={icon || defaultIcon} class="mb-6 w-12 h-12 text-primary" />}
                <div class="text-xl font-bold">{itemTitle}</div>
                {description && <p class="text-muted mt-2" set:html={description} />}
                {callToAction && (
                  <div class="mt-2">
                    <Button {...callToAction} />
                  </div>
                )}
              </>
            );

            return href ? (
              <a
                href={href}
                target={linkTarget}
                rel={linkRel}
                class:list={cardClasses}
                style={cardStyle}
                aria-label={itemTitle}
                data-service-search={searchText}
              >
                {cardContent}
              </a>
            ) : (
              <div class:list={cardClasses} style={cardStyle} data-service-search={searchText}>
                {cardContent}
              </div>
            );
          }
        )}
        </div>
      </>
    )
  }
</WidgetWrapper>
