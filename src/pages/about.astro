---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import Stats from '~/components/widgets/Stats.astro';
import { SITE_BRAND, SITE_CONTACT } from '~/data/site';
import { whyChooseUs } from '~/data/services';
import { PAGE_KEYWORDS } from '~/data/seo';

const metadata = {
  title: 'За нас — строителна фирма София | Иванови Строй',
  description: `${SITE_BRAND.name} — строителна фирма в София, ръководена от ${SITE_BRAND.owner}. Кърти, чисти, извозва и всички ремонтни дейности. Безплатен оглед.`,
  keywords: PAGE_KEYWORDS.about,
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="За нас"
    image={{ src: '/mainpic1.png', alt: SITE_BRAND.name }}
    actions={[
      {
        variant: 'primary',
        text: 'Свържете се с нас',
        href: `tel:${SITE_CONTACT.phoneTel}`,
        icon: 'tabler:phone',
      },
    ]}
  >
    <Fragment slot="title">{SITE_BRAND.name}</Fragment>
    <Fragment slot="subtitle">
      Строителна фирма с опит в <strong>София и областта</strong>. {SITE_BRAND.tagline} — професионално, бързо и на
      конкурентни цени. Ръководител: <strong>{SITE_BRAND.owner}</strong>.
    </Fragment>
  </Hero>

  <Stats
    title="Нашият ангажимент"
    stats={[
      { title: 'Регион', amount: 'София' },
      { title: 'Услуги', amount: '20+' },
      { title: 'Оглед', amount: 'Безплатен' },
      { title: 'Работа', amount: '7/7' },
    ]}
  />

  <Content
    tagline="Мисия"
    title="Всички ремонтни дейности"
    items={whyChooseUs.map((text) => ({
      title: text,
      description: '',
      icon: 'tabler:star-filled',
    }))}
    image={{
      src: '/mainpic2.png',
      alt: 'Строителна фирма София',
    }}
  >
    <Fragment slot="content">
      <p class="text-[#8f8f8f]">
        От къртене и извозване до кофраж, бетон, гипсокартон, ВиК, ЕЛ и баня до ключ — {SITE_BRAND.name} е вашият партньор
        за всичко свързано със строителството в София.
      </p>
    </Fragment>
  </Content>
</Layout>
