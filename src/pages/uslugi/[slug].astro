---
import Layout from '~/layouts/PageLayout.astro';
import ContactButtons from '~/components/ContactButtons.astro';
import ServiceDetailImages from '~/components/ServiceDetailImages.astro';
import {
  serviceCategories,
  getCategoryBySlug,
  hasRealPhotos,
  getCategoryRealImages,
} from '~/data/services';
import { getServiceContent } from '~/data/service-content';
import { getPermalink } from '~/utils/permalinks';
import { SITE_BRAND, SITE_CONTACT } from '~/data/site';

export async function getStaticPaths() {
  return serviceCategories.map((cat) => ({
    params: { slug: cat.slug },
    props: { category: cat },
  }));
}

const { category } = Astro.props;
const pageContent = getServiceContent(category.id);
const showPhotos = hasRealPhotos(category);
const images = getCategoryRealImages(category);

const metadata = {
  title: `${category.title} София`,
  description: pageContent.metaDescription,
};
---

<Layout metadata={metadata}>
  <article class="bg-white">
    <div class="bg-[#f8f8f8] border-b border-[#8f8f8f]/15">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 py-4">
        <nav class="text-sm text-[#8f8f8f]" aria-label="Breadcrumb">
          <a href={getPermalink('/')} class="hover:text-[#c79305]">Начало</a>
          <span class="mx-2">/</span>
          <a href={getPermalink('/services')} class="hover:text-[#c79305]">Услуги</a>
          <span class="mx-2">/</span>
          <span class="text-[#141414] font-medium">{category.title}</span>
        </nav>
      </div>
    </div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-10 md:py-14">
      {category.teaser && (
        <p class="text-sm font-bold uppercase tracking-wider text-[#c79305] mb-3">{category.teaser}</p>
      )}

      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-[#141414] tracking-tight mb-8">
        {category.title}
      </h1>

      <div class="prose prose-lg max-w-none text-[#141414] prose-p:text-[#4a4a4a] prose-p:leading-relaxed prose-headings:text-[#141414] prose-a:text-[#c79305]">
        {pageContent.paragraphs.map((p) => (
          <p>{p}</p>
        ))}
      </div>

      {
        showPhotos && (
          <ServiceDetailImages
            images={images}
            subsections={category.subsections}
            title={category.title}
          />
        )
      }

      <section class="mt-12 pt-10 border-t border-[#8f8f8f]/20 text-center">
        <h2 class="text-xl font-bold text-[#141414] mb-2">Безплатен оглед и оферта</h2>
        <p class="text-[#8f8f8f] mb-6">
          {SITE_BRAND.name} · {SITE_CONTACT.location} · {SITE_CONTACT.phoneIntl}
        </p>
        <ContactButtons />
        <p class="mt-8">
          <a href={getPermalink('/services')} class="text-[#c79305] font-semibold hover:underline">
            ← Всички услуги
          </a>
        </p>
      </section>
    </div>
  </article>
</Layout>
