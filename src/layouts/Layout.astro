---
import '~/assets/styles/tailwind.css';

import { I18N } from 'astrowind:config';

import CommonMeta from '~/components/common/CommonMeta.astro';
import SocialShareMeta from '~/components/common/SocialShareMeta.astro';
import Favicons from '~/components/Favicons.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import ApplyColorMode from '~/components/common/ApplyColorMode.astro';
import Metadata from '~/components/common/Metadata.astro';
import SiteVerification from '~/components/common/SiteVerification.astro';
import Analytics from '~/components/common/Analytics.astro';
import BasicScripts from '~/components/common/BasicScripts.astro';
import StructuredData from '~/components/seo/StructuredData.astro';
import SeoExtras from '~/components/seo/SeoExtras.astro';

import { ClientRouter } from 'astro:transitions';

import type { MetaData as MetaDataType } from '~/types';
import { isNoIndexPath } from '~/data/seo-paths';
import { getSiteStructuredData, PAGE_KEYWORDS } from '~/data/seo';

export interface Props {
  metadata?: MetaDataType;
}

const { metadata = {} } = Astro.props;
const { language, textDirection } = I18N;

const pathname = Astro.url.pathname;
const noIndex = isNoIndexPath(pathname);

const defaultKeywords =
  pathname === '/' || pathname === ''
    ? PAGE_KEYWORDS.home
    : pathname.startsWith('/services')
      ? PAGE_KEYWORDS.services
      : pathname.startsWith('/about')
        ? PAGE_KEYWORDS.about
        : pathname.startsWith('/contact')
          ? PAGE_KEYWORDS.contact
          : undefined;

const mergedMetadata: MetaDataType = {
  ...metadata,
  robots: noIndex ? { index: false, follow: false } : (metadata.robots ?? { index: true, follow: true }),
  keywords: metadata.keywords ?? defaultKeywords,
};

const extraSchema = metadata.structuredData
  ? Array.isArray(metadata.structuredData)
    ? metadata.structuredData
    : [metadata.structuredData]
  : [];

const structuredData = noIndex ? extraSchema : [...getSiteStructuredData(), ...extraSchema];

const isHome = pathname === '/' || pathname === '';
---

<!doctype html>
<html lang={language} dir={textDirection} class="2xl:text-[20px]">
  <head>
    <CommonMeta />
    <SocialShareMeta />
    <Favicons />
    <CustomStyles />
    <ApplyColorMode />
    <Metadata {...mergedMetadata} />
    <SeoExtras keywords={mergedMetadata.keywords} geo={isHome} />
  <StructuredData data={structuredData} />
    <SiteVerification />
    <Analytics />

    <ClientRouter fallback="swap" />
  </head>

  <body class="antialiased text-default bg-page tracking-tight">
    <slot />

    <BasicScripts />
  </body>
</html>
