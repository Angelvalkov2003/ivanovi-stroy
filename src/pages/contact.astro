---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import ContactButtons from '~/components/ContactButtons.astro';
import { SITE_BRAND, SITE_CONTACT } from '~/data/site';

const metadata = {
  title: 'Контакти',
  description: `Свържете се с ${SITE_BRAND.name} — телефон ${SITE_CONTACT.phone}, София и областта. WhatsApp и Viber.`,
};
---

<Layout metadata={metadata}>
  <HeroText tagline="Контакти" title="Обадете се сега!" />

  <Features2
    title="Свържете се с нас"
    subtitle="Безплатен оглед и оферта · Бърз отговор"
    columns={2}
    items={[
      {
        title: 'Телефон',
        description: `<a href="tel:${SITE_CONTACT.phoneTel}" class="text-[#c79305] font-bold text-xl">${SITE_CONTACT.phone}</a>`,
        icon: 'tabler:phone',
      },
      {
        title: 'WhatsApp',
        description: `<a href="${SITE_CONTACT.whatsapp}" target="_blank" rel="noopener" class="text-[#c79305] hover:underline">Пишете в WhatsApp</a>`,
        icon: 'tabler:brand-whatsapp',
      },
      {
        title: 'Viber',
        description: `<a href="${SITE_CONTACT.viber}" class="text-[#c79305] hover:underline">Пишете в Viber</a>`,
        icon: 'tabler:message-circle',
      },
      {
        title: 'Имейл',
        description: `<a href="mailto:${SITE_CONTACT.email}" class="text-[#c79305] hover:underline">${SITE_CONTACT.email}</a>`,
        icon: 'tabler:mail',
      },
      {
        title: 'Локация',
        description: SITE_CONTACT.location,
        icon: 'tabler:map-pin',
      },
      {
        title: 'Работно време',
        description: 'Работа без почивен ден — удобно за спешни поръчки',
        icon: 'tabler:clock',
      },
    ]}
  />

  <section class="py-12 bg-[#f8f8f8]">
    <div class="max-w-xl mx-auto px-4 text-center">
      <h2 class="text-2xl font-bold text-[#141414] mb-4">Обадете се сега!</h2>
      <p class="text-[#8f8f8f] mb-6">Безплатен оглед и оферта за вашия обект в София и областта.</p>
      <ContactButtons size="md" />
    </div>
  </section>
</Layout>
