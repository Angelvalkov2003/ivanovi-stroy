---
interface Props {
  data?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const { data = [] } = Astro.props;
const graphs = (Array.isArray(data) ? data : [data]).filter(Boolean);

if (!graphs.length) {
  return null;
}

const payload =
  graphs.length === 1
    ? { '@context': 'https://schema.org', ...graphs[0] }
    : { '@context': 'https://schema.org', '@graph': graphs };
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(payload)} />
